---
import type { CollectionEntry } from "astro:content";

interface Props {
  member: CollectionEntry<"members">;
  role: string;
  group: string;
  index?: number;
}

const { member, role, group, index = 0 } = Astro.props;
const { data } = member;
const hasPhoto = Boolean(data.photo);
---

<article class="member-card">
  <div
    class:list={[
      "member-card__visual",
      { "member-card__visual--placeholder": !hasPhoto },
    ]}
    aria-hidden="true"
  >
    <img
      src={data.photo ?? "/lcl-logo.svg"}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <small>{String(index + 1).padStart(2, "0")}</small>
  </div>

  <div class="member-card__info">
    <div class="member-card__role">
      <span>{role}</span>
      <span>{group}</span>
    </div>
    <h2>{data.name}</h2>
    <p class="member-card__name-en">{data.nameEn}</p>
    <div class="member-card__bio">
      <slot />
    </div>
    {
      data.interests.length > 0 && (
        <ul class="member-card__interests" aria-label="관심 연구 분야">
          {data.interests.map((interest) => <li>{interest}</li>)}
        </ul>
      )
    }
    {
      (data.github || data.website || data.email) && (
        <div class="member-card__links">
          {data.github && (
            <a href={data.github} target="_blank" rel="noreferrer">
              GitHub <span>↗</span>
            </a>
          )}
          {data.website && (
            <a href={data.website} target="_blank" rel="noreferrer">
              Website <span>↗</span>
            </a>
          )}
          {data.email && (
            <a href={`mailto:${data.email}`}>
              Email <span>↗</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  .member-card {
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    border: 1px solid var(--line);
    background: var(--white);
  }

  .member-card__visual {
    position: relative;
    display: grid;
    aspect-ratio: 4 / 3;
    color: var(--white);
    background: var(--ink);
    place-items: center;
    overflow: hidden;
  }

  .member-card__visual > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .member-card__visual--placeholder > img {
    width: min(52%, 14rem);
    height: auto;
    opacity: 0.88;
    filter: invert(1);
  }

  .member-card__visual small {
    position: absolute;
    top: 1rem;
    left: 1rem;
    color: #858581;
    font-size: 0.58rem;
    font-weight: 700;
  }

  .member-card__info {
    display: flex;
    min-width: 0;
    padding: clamp(1.25rem, 1.8vw, 2rem);
    flex: 1;
    flex-direction: column;
    background: var(--white);
  }

  .member-card__role {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--muted);
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h2 {
    margin: clamp(2.5rem, 4vw, 4rem) 0 0;
    font-size: clamp(2.1rem, 3.2vw, 3.75rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.075em;
  }

  .member-card__name-en {
    margin: 0.5rem 0 1.35rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-style: italic;
  }

  .member-card__bio {
    color: #484844;
    font-size: 0.88rem;
    line-height: 1.65;
    word-break: keep-all;
  }

  .member-card__bio :global(p) {
    margin: 0;
  }

  .member-card__interests {
    display: flex;
    margin-top: 1.5rem;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .member-card__interests li {
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .member-card__links {
    display: flex;
    margin-top: auto;
    padding-top: 1.75rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .member-card__links a {
    display: inline-flex;
    padding-bottom: 0.35rem;
    gap: 1rem;
    border-bottom: 1px solid var(--ink);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .member-card__links a span {
    transition: transform 250ms ease;
  }

  .member-card__links a:hover span {
    transform: rotate(45deg);
  }

  @media (max-width: 48rem) {
    .member-card__visual {
      aspect-ratio: 16 / 10;
    }

    h2 {
      margin-top: 2.5rem;
    }
  }
</style>
