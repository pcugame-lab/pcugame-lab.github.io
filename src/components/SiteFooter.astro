---
import { getSiteContent } from "../lib/content";

const { data: content } = await getSiteContent();
const { site, footer, wordmark } = content;
const year = new Date().getFullYear();
const copyright = footer.copyrightTemplate
  .replace("{year}", String(year))
  .replace("{shortName}", site.shortName);
---

<footer class="site-footer">
  <div class="site-footer__top container">
    <div class="footer-intro">
      <p class="eyebrow">{footer.eyebrow}</p>
      <p class="footer-intro__title">
        {
          footer.titleLines.map((line, index) => (
            <>{index > 0 && <br />}{line}</>
          ))
        }
      </p>
    </div>

    <div class="footer-links">
      <div>
        <p>{footer.navigationLabel}</p>
        {
          site.navigation.map((item) => (
            <a href={item.href}>
              <span>{item.index}</span>
              {item.label}
            </a>
          ))
        }
      </div>
      <div>
        <p>{footer.connectLabel}</p>
        <a href={site.github} target="_blank" rel="noreferrer">
          <span>↗</span>
          {footer.githubLabel}
        </a>
      </div>
    </div>
  </div>

  <div class="footer-wordmark container" aria-label={wordmark.join(" ")}>
    {wordmark.map((word) => <span>{word}</span>)}
  </div>

  <div class="site-footer__bottom container">
    <p>{copyright}</p>
    <p>{footer.tagline}</p>
    <a href="#top" aria-label={footer.backToTopAriaLabel}>
      {footer.backToTopLabel}
    </a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    color: var(--white);
    background: var(--ink);
    border-top: 1px solid var(--line-dark);
    overflow: hidden;
  }

  .site-footer__top {
    display: grid;
    padding-block: clamp(4.5rem, 8vw, 8rem);
    grid-template-columns: minmax(0, 1.3fr) minmax(20rem, 0.7fr);
    gap: 5rem;
  }

  .footer-intro__title {
    max-width: 55rem;
    margin: 2.5rem 0 0;
    font-size: clamp(2.7rem, 6.4vw, 7.5rem);
    font-weight: 600;
    line-height: 0.97;
    letter-spacing: -0.065em;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer-links > div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-links p {
    width: 100%;
    margin: 0 0 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--line-dark);
    color: #777;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-links a {
    display: flex;
    padding-block: 0.45rem;
    gap: 0.6rem;
    color: #ccc;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .footer-links a:hover {
    color: var(--white);
  }

  .footer-links a span {
    color: #666;
    font-size: 0.6rem;
  }

  .footer-wordmark {
    display: flex;
    padding-block: 1.2rem 2.5rem;
    flex-direction: column;
    align-items: flex-start;
    border-top: 1px solid var(--line-dark);
    font-size: clamp(4rem, 11.2vw, 13rem);
    font-weight: 700;
    line-height: 0.78;
    letter-spacing: -0.085em;
  }

  .footer-wordmark > span {
    display: block;
  }

  .footer-wordmark > span:last-child {
    margin-top: 0.25em;
    color: transparent;
    -webkit-text-stroke: 1px #555;
  }

  .site-footer__bottom {
    display: grid;
    padding-block: 1.5rem 2rem;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    border-top: 1px solid var(--line-dark);
    color: #777;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-footer__bottom p {
    margin: 0;
  }

  .site-footer__bottom p:nth-child(2) {
    text-align: center;
  }

  .site-footer__bottom a {
    justify-self: end;
    text-decoration: none;
  }

  @media (max-width: 48rem) {
    .site-footer__top {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .site-footer__bottom {
      grid-template-columns: 1fr auto;
    }

    .site-footer__bottom p:nth-child(2) {
      display: none;
    }
  }
</style>
