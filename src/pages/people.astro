---
import { render } from "astro:content";
import MemberCard from "../components/MemberCard.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getMembers } from "../lib/content";

const members = await getMembers();
const renderedMembers = await Promise.all(
  members.map(async (member) => ({
    member,
    Content: (await render(member)).Content,
  })),
);
---

<BaseLayout
  title="구성원"
  description="Ludic Core Laboratory를 함께 만드는 연구자들을 소개합니다."
>
  <PageHero
    index="03"
    eyebrow="People"
    title="구성원"
    titleEn="Different Minds, One Core"
    description="서로 다른 관심과 기술을 가진 사람들이 같은 질문을 각자의 방식으로 탐구합니다."
  />

  <section class="people-intro section--compact">
    <div class="container">
      <p class="eyebrow">Lab Members</p>
      <p>
        좋은 플레이는 한 사람의 정답보다<br />
        서로 다른 시선이 만나는 곳에서 시작됩니다.
      </p>
    </div>
  </section>

  <section class="members">
    <div class="container">
      {
        renderedMembers.map(({ member, Content }, index) => (
          <MemberCard member={member} index={index}>
            <Content />
          </MemberCard>
        ))
      }
    </div>
  </section>

  <section class="join section section--dark">
    <div class="container">
      <span>Open Questions, Open Minds.</span>
      <h2>함께 질문하고,<br />함께 플레이합니다.</h2>
      <a class="text-link" href="https://github.com/pcugame-lab" target="_blank" rel="noreferrer">
        GitHub에서 만나기
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M2 10h15M11 4l6 6-6 6" fill="none" stroke="currentColor"></path>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .people-intro {
    background: var(--paper);
  }

  .people-intro .container {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
  }

  .people-intro .container > p:last-child {
    max-width: 62rem;
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 6.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.065em;
    word-break: keep-all;
  }

  .members {
    padding-bottom: clamp(5rem, 10vw, 10rem);
    background: var(--paper);
  }

  .members :global(.member-card + .member-card) {
    margin-top: clamp(4rem, 8vw, 8rem);
  }

  .join .container {
    position: relative;
  }

  .join span {
    color: #777;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .join h2 {
    margin: clamp(3rem, 6vw, 6rem) 0;
    font-size: clamp(3.5rem, 9vw, 10rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.075em;
  }

  .join .text-link {
    color: var(--white);
  }

  @media (max-width: 48rem) {
    .people-intro .container {
      grid-template-columns: 1fr;
    }
  }
</style>
