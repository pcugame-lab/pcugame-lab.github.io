---
import { render, type CollectionEntry } from "astro:content";
import ProjectVisual from "../../components/ProjectVisual.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const projects = await getProjects();
const currentIndex = projects.findIndex(({ id }) => id === project.id);
const nextProject = projects[(currentIndex + 1) % projects.length];
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article class="project-detail">
    <header class="project-detail__hero" id="top">
      <div class="container">
        <div class="project-detail__crumb">
          <a href="/research/">Research</a>
          <span>/</span>
          <span>{project.data.code}</span>
        </div>

        <div class="project-detail__title">
          <div>
            <p>{project.data.titleEn}</p>
            <h1>{project.data.title}</h1>
          </div>
          <span>{project.data.code}</span>
        </div>

        <div class="project-detail__summary">
          <dl>
            <div>
              <dt>Year</dt>
              <dd>{project.data.year}</dd>
            </div>
            <div>
              <dt>Status</dt>
              <dd>{project.data.phase}</dd>
            </div>
          </dl>
          <p>{project.data.summary}</p>
        </div>
      </div>
    </header>

    <div class="project-detail__visual container">
      <ProjectVisual visual={project.data.visual} label={project.data.code} />
    </div>

    <section class="project-detail__content section">
      <div class="project-detail__content-inner container">
        <aside>
          <p class="eyebrow">Project Note</p>
          <ul>
            {project.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </aside>
        <div class="prose">
          <Content />
        </div>
      </div>
    </section>
  </article>

  {
    nextProject && (
      <a
        class="next-project"
        href={`/research/${nextProject.id}/`}
        aria-label={`다음 연구: ${nextProject.data.title}`}
      >
        <div class="container">
          <span>Next Project / {nextProject.data.code}</span>
          <strong>{nextProject.data.title}</strong>
          <i aria-hidden="true">→</i>
        </div>
      </a>
    )
  }
</BaseLayout>

<style>
  .project-detail {
    background: var(--paper);
  }

  .project-detail__hero {
    padding-block: clamp(2rem, 5vw, 5rem) clamp(5rem, 10vw, 10rem);
    color: var(--white);
    background: var(--ink);
  }

  .project-detail__crumb {
    display: flex;
    gap: 0.65rem;
    color: #777;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-detail__crumb a {
    color: #bbb;
    text-decoration: none;
  }

  .project-detail__title {
    display: grid;
    margin-top: clamp(5rem, 10vw, 10rem);
    align-items: end;
    grid-template-columns: 1fr auto;
    gap: 2rem;
  }

  .project-detail__title p {
    margin: 0 0 0.7rem;
    color: #888;
    font-size: clamp(1rem, 1.8vw, 1.5rem);
    font-style: italic;
  }

  h1 {
    max-width: 90rem;
    margin: 0;
    font-size: clamp(4rem, 10vw, 11rem);
    font-weight: 600;
    line-height: 0.88;
    letter-spacing: -0.08em;
    word-break: keep-all;
  }

  .project-detail__title > span {
    color: #555;
    font-size: clamp(2rem, 5vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.06em;
  }

  .project-detail__summary {
    display: grid;
    margin-top: clamp(4rem, 8vw, 8rem);
    padding-top: 2rem;
    align-items: start;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    border-top: 1px solid var(--line-dark);
  }

  .project-detail__summary dl {
    display: grid;
    max-width: 25rem;
    margin: 0;
    grid-template-columns: 1fr 1fr;
  }

  .project-detail__summary dt {
    margin-bottom: 0.7rem;
    color: #666;
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-detail__summary dd {
    margin: 0;
    color: #aaa;
    font-size: 0.85rem;
  }

  .project-detail__summary > p {
    max-width: 40rem;
    margin: 0;
    justify-self: end;
    color: #c3c3be;
    font-size: clamp(1.1rem, 1.8vw, 1.5rem);
    line-height: 1.7;
    word-break: keep-all;
  }

  .project-detail__visual {
    margin-top: clamp(-5rem, -6vw, -3rem);
  }

  .project-detail__visual :global(.project-visual) {
    aspect-ratio: 2.05;
    border: 1px solid #292929;
  }

  .project-detail__content-inner {
    display: grid;
    grid-template-columns: minmax(12rem, 0.5fr) minmax(0, 1.5fr);
    gap: 3rem;
  }

  .project-detail__content aside ul {
    display: flex;
    margin-top: 2rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .project-detail__content aside li {
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .next-project {
    display: block;
    color: var(--white);
    background: var(--ink);
    text-decoration: none;
  }

  .next-project > div {
    display: grid;
    min-height: clamp(18rem, 32vw, 34rem);
    padding-block: 2rem;
    align-items: center;
    grid-template-columns: 1fr 3fr auto;
    gap: 2rem;
  }

  .next-project span {
    color: #777;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .next-project strong {
    font-size: clamp(2.8rem, 7vw, 8rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.07em;
  }

  .next-project i {
    font-size: clamp(2rem, 5vw, 5rem);
    font-style: normal;
    transition: transform 400ms var(--ease-out);
  }

  .next-project:hover i {
    transform: translateX(1rem);
  }

  @media (max-width: 48rem) {
    .project-detail__title {
      grid-template-columns: 1fr;
    }

    .project-detail__title > span {
      display: none;
    }

    .project-detail__summary,
    .project-detail__content-inner {
      grid-template-columns: 1fr;
    }

    .project-detail__summary > p {
      justify-self: start;
    }

    .project-detail__visual :global(.project-visual) {
      aspect-ratio: 1.25;
    }

    .next-project > div {
      align-content: center;
      grid-template-columns: 1fr auto;
    }

    .next-project strong {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
