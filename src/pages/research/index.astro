---
import PageHero from "../../components/PageHero.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPageContent, getProjects } from "../../lib/content";

const [projects, { data: content }] = await Promise.all([
  getProjects(),
  getPageContent("research"),
]);
---

<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
>
  <PageHero
    index={content.hero.index}
    eyebrow={content.hero.eyebrow}
    title={content.hero.title}
    titleEn={content.hero.titleEn}
    description={content.hero.description}
  />

  <section class="research-index section">
    <div class="container">
      <header class="research-index__header">
        <p class="eyebrow">{content.listEyebrow}</p>
        <p>
          {
            content.listDescriptionLines.map((line, index) => (
              <>{index > 0 && <br />}{line}</>
            ))
          }
        </p>
      </header>

      <div class="research-index__grid">
        {
          projects.map((project, index) => (
            <ProjectCard project={project} index={index} />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .research-index {
    background: var(--white);
  }

  .research-index__header {
    display: grid;
    margin-bottom: clamp(4rem, 8vw, 8rem);
    padding-bottom: 2rem;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--line);
  }

  .research-index__header > p:last-child {
    max-width: 34rem;
    margin: 0;
    justify-self: end;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
    word-break: keep-all;
  }

  .research-index__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(4rem, 8vw, 8rem) clamp(1.5rem, 4vw, 5rem);
  }

  .research-index__grid > :global(:nth-child(even)) {
    margin-top: clamp(3rem, 8vw, 9rem);
  }

  @media (max-width: 48rem) {
    .research-index__header,
    .research-index__grid {
      grid-template-columns: 1fr;
    }

    .research-index__header {
      gap: 2rem;
    }

    .research-index__header > p:last-child {
      justify-self: start;
    }

    .research-index__grid {
      gap: 4rem;
    }

    .research-index__grid > :global(:nth-child(even)) {
      margin-top: 0;
    }
  }
</style>
